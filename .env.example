# Clerk (dev instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Convex
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.<region>.convex.cloud
CONVEX_DEPLOYMENT=dev:<deployment>

# Clerk issuer domain used by convex/auth.config.ts (also set in Convex env)
CLERK_JWT_ISSUER_DOMAIN=https://<subdomain>.clerk.accounts.dev
